{
  "manifest_version": 3,
  "name": "CAPSTONE-1 Phishing Threat Detector",
  "version": "1.3.0",
  "description": "Local-first, privacy-preserving phishing threat detection engine",
  "permissions": [
    "declarativeNetRequest",
    "offscreen",
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "webRequest",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "CAPSTONE-1 Detector"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dnr_rules",
        "enabled": true,
        "path": "dnr-rules.json"
      }
    ]
  }
}
